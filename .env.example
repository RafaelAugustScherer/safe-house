# Copy to .env and fill in. Required for `docker compose up`.

# Database credentials (Postgres container).
POSTGRES_USER=safehouse
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=safehouse

# Public hostname for Caddy. For local dev set to ":80" (Caddy will not
# attempt to issue certificates). For production use a real domain like
# "play.example.com" and Caddy will auto-issue Let's Encrypt certs.
PUBLIC_DOMAIN=:80

# Origin used by the API for CORS — typically the public URL. Match the
# scheme/host you use to reach the web service.
PUBLIC_ORIGIN=http://localhost
