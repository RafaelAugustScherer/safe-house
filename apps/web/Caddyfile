{
	# Cloudflare Tunnel terminates TLS at the edge, so Caddy serves plain HTTP.
	auto_https off
}

{$PUBLIC_DOMAIN::80} {
	encode gzip

	# WebSocket + Socket.IO traffic. handle blocks are mutually exclusive —
	# they short-circuit before any rewrite runs, so try_files below cannot
	# accidentally rewrite /socket.io/... to /index.html.
	handle /socket.io/* {
		reverse_proxy api:4000
	}

	# REST endpoints (currently unused, reserved).
	handle /api/* {
		reverse_proxy api:4000
	}

	# Health endpoint proxied for convenience (e.g. from cloudflared).
	handle /health {
		reverse_proxy api:4000
	}

	# Static SPA: try the file, otherwise fall back to index.html so client
	# routes (e.g. /room/:id) are served by React Router.
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}
