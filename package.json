{
  "name": "safehouse",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build:shared": "npm run build -w @safehouse/shared",
    "dev:web": "npm run start -w @safehouse/web",
    "dev:api": "npm run dev -w @safehouse/api",
    "build:web": "npm run build -w @safehouse/web",
    "build:api": "npm run build -w @safehouse/api",
    "test": "npm run test --workspaces --if-present"
  }
}
